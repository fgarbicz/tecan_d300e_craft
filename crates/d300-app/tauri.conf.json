{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tecan D300 Craft",
  "version": "0.2.0",
  "identifier": "app.d300designer.desktop",
  "build": {
    "frontendDist": "../../web-dist",
    "beforeDevCommand": {
      "script": "node tools/build_web.mjs",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "node tools/build_web.mjs",
      "cwd": "../.."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tecan D300 Craft",
        "url": "app/index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "public.app-category.education",
    "shortDescription": "Tecan D300e protocol and experiment designer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
